<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - Raizen Gen</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <%- include('partials/nav', { path: '/profile' }) %>
    
    <div class="container">
        <div class="profile-header">
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="profile-avatar">
            <div class="profile-info">
                <h1><%= user.username %><span class="discriminator">#<%= user.discriminator %></span></h1>
                <p><i class="fas fa-trophy"></i> Vouches: <strong><%= vouchCount %></strong></p>
                <p><i class="fas fa-shield-alt"></i> Rank: <strong><%= rank %></strong></p>
                <p><i class="fas fa-gamepad"></i> Gen Tier: <strong><%= tier %></strong></p>
            </div>
        </div>

        <div class="profile-actions">
            <a href="/gen" class="btn btn-primary"><i class="fas fa-gamepad"></i> Generate Account</a>
            <a href="/giveaways" class="btn btn-secondary"><i class="fas fa-gift"></i> View Giveaways</a>
        </div>

        <div class="profile-stats">
            <div class="stat-box">
                <i class="fas fa-star"></i>
                <h3><%= vouchCount %></h3>
                <p>Total Vouches</p>
            </div>
            <div class="stat-box">
                <i class="fas fa-calendar"></i>
                <h3><t:<%= Math.floor(Date.now() / 1000) %>:R></h3>
                <p>Member Since</p>
            </div>
        </div>
    </div>
</body>
</html>
