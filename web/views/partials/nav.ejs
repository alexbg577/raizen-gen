<nav>
    <div class="nav-brand">
        <img src="https://i.imgur.com/8xZq3eE.png" alt="Logo" class="logo">
        <span>Raizen Gen</span>
    </div>
    <div class="nav-links">
        <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
        <a href="/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>">Dashboard</a>
        <a href="/gen" class="<%= path === '/gen' ? 'active' : '' %>">Generate</a>
        <a href="/leaderboard" class="<%= path === '/leaderboard' ? 'active' : '' %>">Leaderboard</a>
        <a href="/giveaways" class="<%= path === '/giveaways' ? 'active' : '' %>">Giveaways</a>
        <% if (user) { %>
            <a href="/profile/<%= user.id %>" class="profile-link">
                <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="nav-avatar">
                <span><%= user.username %></span>
            </a>
            <a href="/logout" class="logout-btn">Logout</a>
        <% } else { %>
            <a href="/login" class="login-btn">Login</a>
        <% } %>
    </div>
</nav>
