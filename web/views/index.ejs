<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raizen Gen - Home</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav>
        <div class="nav-brand">
            <img src="/images/logo.svg" alt="Logo" class="logo">
            <span>Raizen Gen</span>
        </div>
        <div class="nav-links">
            <a href="/" class="active">Home</a>
            <a href="/dashboard">Dashboard</a>
            <a href="/gen">Generate</a>
            <a href="/leaderboard">Leaderboard</a>
            <a href="/giveaways">Giveaways</a>
            <% if (user) { %>
                <a href="/logout" class="logout-btn">Logout</a>
            <% } else { %>
                <a href="/login" class="login-btn">Login</a>
            <% } %>
        </div>
    </nav>

    <div class="container">
        <header class="hero">
            <h1>🎮 Welcome to Raizen Gen</h1>
            <p>Your ultimate gaming accounts provider</p>
            <% if (user) { %>
                <div class="user-welcome">
                    <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" class="avatar">
                    <p>Welcome back, <strong><%= user.username %></strong>!</p>
                </div>
            <% } %>
        </header>

        <div class="stats-grid">
            <div class="stat-card free">
                <div class="stat-icon">🟢</div>
                <div class="stat-info">
                    <h3>Free</h3>
                    <p class="stat-count"><%= counts.free %></p>
                </div>
            </div>
            <div class="stat-card premium">
                <div class="stat-icon">🔵</div>
                <div class="stat-info">
                    <h3>Premium</h3>
                    <p class="stat-count"><%= counts.premium %></p>
                </div>
            </div>
            <div class="stat-card booster">
                <div class="stat-icon">🟣</div>
                <div class="stat-info">
                    <h3>Booster</h3>
                    <p class="stat-count"><%= counts.booster %></p>
                </div>
            </div>
            <div class="stat-card extreme">
                <div class="stat-icon">🔴</div>
                <div class="stat-info">
                    <h3>Extreme</h3>
                    <p class="stat-count"><%= counts.extreme %></p>
                </div>
            </div>
        </div>

        <div class="features">
            <h2>🚀 Features</h2>
            <div class="feature-grid">
                <div class="feature-card">
                    <i class="fas fa-gamepad"></i>
                    <h3>Generate Accounts</h3>
                    <p>Get free accounts for your favorite games</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-trophy"></i>
                    <h3>Vouch System</h3>
                    <p>Build reputation with our vouch system</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-gift"></i>
                    <h3>Giveaways</h3>
                    <p>Participate in exciting giveaways</p>
                </div>
                <div class="feature-card">
                    <i class="fas fa-chart-line"></i>
                    <h3>Leaderboard</h3>
                    <p>See top vouched members</p>
                </div>
            </div>
        </div>

        <div class="cta-section">
            <% if (!user) { %>
                <a href="/login" class="cta-button">Get Started - Login with Discord</a>
            <% } else { %>
                <a href="/gen" class="cta-button">Generate an Account</a>
            <% } %>
        </div>
    </div>

    <footer>
        <p>© 2026 Raizen Gen • Powered by Discord.js</p>
    </footer>
</body>
</html>
