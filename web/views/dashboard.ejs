<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Raizen Gen</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav>
        <div class="nav-brand">
            <img src="/images/logo.svg" alt="Logo" className="logo">
            <span>Raizen Gen</span>
        </div>
        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/dashboard" class="active">Dashboard</a>
            <a href="/gen">Generate</a>
            <a href="/leaderboard">Leaderboard</a>
            <a href="/giveaways">Giveaways</a>
            <a href="/logout" class="logout-btn">Logout</a>
        </div>
    </nav>

    <div class="container">
        <div class="dashboard-header">
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" alt="Avatar" className="avatar">
            <div class="user-info">
                <h2>Welcome back, <%= user.username %>!</h2>
                <p><i class="fas fa-user-tag"></i> <%= user.username %>#<%= user.discriminator %></p>
                <p><i class="fas fa-clock"></i> Last login: Just now</p>
            </div>
        </div>
        
        <div class="stats-grid">
            <div class="stat-card free">
                <div class="stat-icon">🟢</div>
                <div class="stat-info">
                    <h3>Free</h3>
                    <p class="stat-count"><%= counts.free %></p>
                    <p class="stat-label">Available accounts</p>
                </div>
            </div>
            <div class="stat-card premium">
                <div class="stat-icon">🔵</div>
                <div class="stat-info">
                    <h3>Premium</h3>
                    <p class="stat-count"><%= counts.premium %></p>
                    <p class="stat-label">Available accounts</p>
                </div>
            </div>
            <div class="stat-card booster">
                <div class="stat-icon">🟣</div>
                <div class="stat-info">
                    <h3>Booster</h3>
                    <p class="stat-count"><%= counts.booster %></p>
                    <p class="stat-label">Available accounts</p>
                </div>
            </div>
            <div class="stat-card extreme">
                <div class="stat-icon">🔴</div>
                <div class="stat-info">
                    <h3>Extreme</h3>
                    <p class="stat-count"><%= counts.extreme %></p>
                    <p class="stat-label">Available accounts</p>
                </div>
            </div>
        </div>

        <div class="quick-actions">
            <h2>🚀 Quick Actions</h2>
            <div class="action-grid">
                <a href="/gen" class="action-card">
                    <i class="fas fa-gamepad"></i>
                    <h3>Generate</h3>
                    <p>Get an account</p>
                </a>
                <a href="/giveaways" class="action-card">
                    <i class="fas fa-gift"></i>
                    <h3>Giveaways</h3>
                    <p>Participate</p>
                </a>
                <a href="/leaderboard" class="action-card">
                    <i class="fas fa-trophy"></i>
                    <h3>Leaderboard</h3>
                    <p>See rankings</p>
                </a>
            </div>
        </div>
    </div>
</body>
</html>
